# Copy to .env for local Docker Compose. Never commit real credentials.
REMINDERHUB_DB_HOST=db
REMINDERHUB_DB_NAME=reminderhub
REMINDERHUB_DB_USER=reminderhub_app
REMINDERHUB_DB_PASS=replace-with-a-strong-local-password

MYSQL_DATABASE=reminderhub
MYSQL_USER=reminderhub_app
MYSQL_PASSWORD=replace-with-a-strong-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-local-password
